{
  "name": "ddd/inventory",
  "description": "DDD Inventory app",
  "require": {
    "php": ">=8.1",
    "illuminate/database": "^10.0",
    "vlucas/phpdotenv": "^5.5",
    "psr/event-dispatcher": "^1.0",
    "ramsey/uuid": "^4.7",
    "php-amqplib/php-amqplib": "^2.8",
    "php-mqtt/client": "^2.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "InventoryApp\\": "src/",
      "App\\": "src/"
    },
    "files": [
      "src/Domain/Aging/AgingEntities.php",
      "src/Domain/Aging/AgingServices.php",
      "src/Domain/Billing/BillingEntities.php",
      "src/Domain/Billing/BillingServices.php",
      "src/Domain/Intercompany/IntercompanyEntities.php",
      "src/Domain/Intercompany/IntercompanyServices.php",
      "src/Domain/Labor/LaborEntities.php",
      "src/Domain/Labor/LaborServices.php",
      "src/Domain/Notification/NotificationServices.php",
      "src/Domain/Notification/NotificationEntities.php",
      "src/Domain/Vision/VisionEntities.php",
      "src/Domain/Vision/VisionServices.php",
      "src/Domain/YieldManagement/YieldEntities.php",
      "src/Domain/YieldManagement/YieldServices.php"
    ]
  }
}
